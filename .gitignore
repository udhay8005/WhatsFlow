# ============================================================
# WhatsFlow — .gitignore
# Author: Udhaya Chandra SA
# ============================================================

# ─── Secrets & Environment ───────────────────────────────────
.env
.env.*
!.env.template

# ─── Databases ───────────────────────────────────────────────
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
database.sqlite
database.test.sqlite

# ─── Logs ────────────────────────────────────────────────────
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Uploads ─────────────────────────────────────────────────
uploads/
backend/uploads/

# ─── Dependencies ────────────────────────────────────────────
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# ─── Build Output ────────────────────────────────────────────
dist/
frontend/dist/
dist/win-unpacked/
dist/builder-effective-config.yaml
dist/*.blockmap
build/

# ─── Test & Coverage ─────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ─── Cache ───────────────────────────────────────────────────
.cache/
.parcel-cache/
*.tsbuildinfo
.eslintcache
.stylelintcache
.vite/
frontend/.vite/

# ─── IDE & Editors ───────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iml

# ─── OS Generated ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Temporary Files ─────────────────────────────────────────
tmp/
temp/
backups/
*.tmp
*.bak
*.swp

# ─── Security / Certificates ─────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.der

# ─── Electron ────────────────────────────────────────────────
.claude/

# ─── Misc ────────────────────────────────────────────────────
*.tgz
*.tar.gz
