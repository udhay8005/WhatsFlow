# =============================================================================
# WhatsFlow — Environment Configuration Template
# Author: Udhaya Chandra SA
# =============================================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.template .env
#   2. Fill in your actual values below
#   3. NEVER commit your .env file to version control
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────

# Runtime environment: development | production | test
NODE_ENV=development

# HTTP server port (default: 3000)
PORT=3000

# Winston log level: error | warn | info | verbose | debug | silly
LOG_LEVEL=info

# ─── WhatsApp API ─────────────────────────────────────────────────────────────

# Meta Graph API version (default: v19.0)
WA_API_VERSION=v19.0

# ─── LocalTunnel (Webhook Receiver) ──────────────────────────────────────────

# Set to 'true' to auto-start LocalTunnel on server launch
ENABLE_TUNNEL=false

# Custom subdomain for LocalTunnel (leave blank for random)
# Example: mycompany-whatsflow → https://mycompany-whatsflow.loca.lt
TUNNEL_SUBDOMAIN=
