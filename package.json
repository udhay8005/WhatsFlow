{
  "name": "whatsflow",
  "version": "1.0.1",
  "description": "WhatsApp Bulk Sender (Localhost)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:prod": "cross-env NODE_ENV=production ENABLE_TUNNEL=true electron .",
    "start:tunnel": "cross-env NODE_ENV=production ENABLE_TUNNEL=true TUNNEL_SUBDOMAIN=whatsflow-custom electron .",
    "dev": "concurrently \"npm run server\" \"npm run frontend\" \"wait-on http://localhost:3000 http://localhost:5173 && electron .\"",
    "server": "node backend/server.js",
    "frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend && electron-builder",
    "build:frontend": "cd frontend && npm run build",
    "test": "jest --coverage",
    "test:watchAll": "jest --watchAll",
    "test:unit": "jest backend/__tests__",
    "dev:headless": "concurrently \"npm run server\" \"npm run frontend\"",
    "prepare": "husky",
    "lint:backend": "node --input-type=module -e \"\" 2>/dev/null || true",
    "lint:frontend": "cd frontend && npm run lint"
  },
  "keywords": [],
  "author": "Udhaya Chandra SA",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@jest/globals": "^30.3.0",
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "rcedit": "^4.0.1",
    "supertest": "^7.2.2",
    "wait-on": "^9.0.4"
  },
  "lint-staged": {
    "frontend/src/**/*.{js,jsx}": [
      "npx --prefix frontend eslint --config frontend/eslint.config.js --fix --max-warnings=0"
    ]
  },
  "dependencies": {
    "axios": "^1.13.6",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.3.1",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "localtunnel": "^2.0.2",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "winston": "^3.19.0"
  },
  "overrides": {
    "localtunnel": {
      "axios": "^1.7.9"
    },
    "qs": "^6.14.2",
    "socket.io-parser": "^4.2.6"
  },
  "build": {
    "appId": "com.whatsflow.app",
    "productName": "WhatsFlow",
    "asar": false,
    "afterPack": "scripts/after-pack.js",
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "icon": "frontend/public/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "WhatsFlow"
    }
  }
}
