{
  "name": "whatsflow",
  "version": "1.0.0",
  "description": "WhatsApp Bulk Sender (Localhost)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:prod": "cross-env NODE_ENV=production ENABLE_TUNNEL=true electron .",
    "start:tunnel": "cross-env NODE_ENV=production ENABLE_TUNNEL=true TUNNEL_SUBDOMAIN=whatsflow-custom electron .",
    "dev": "concurrently \"npm run server\" \"npm run frontend\" \"wait-on http://localhost:3000 http://localhost:5173 && electron .\"",
    "server": "node backend/server.js",
    "frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend && electron-builder",
    "build:frontend": "cd frontend && npm run build",
    "test": "jest --coverage",
    "test:watchAll": "jest --watchAll",
    "test:unit": "jest backend/__tests__",
    "dev:headless": "concurrently \"npm run server\" \"npm run frontend\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@playwright/test": "^1.57.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.4.0",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "localtunnel": "^2.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.0",
    "socket.io": "^4.7.0",
    "sqlite3": "^5.1.0",
    "winston": "^3.19.0"
  },
  "build": {
    "appId": "com.whatsflow.app",
    "productName": "WhatsFlow",
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["portable", "nsis"],
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "icon": "frontend/public/logo.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}